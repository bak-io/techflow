{
    "name":  "techflow",
    "version":  "1.0.0",
    "description":  "Teknik bilgi ve not yönetim uygulaması",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "build":  "electron-builder --win",
                    "build:linux":  "electron-builder --linux AppImage deb --x64"
                },
    "keywords":  [
                     "electron",
                     "notes",
                     "technical",
                     "knowledge-base"
                 ],
    "author":  "Esad Baki Çelik",
    "license":  "MIT",
    "devDependencies":  {
                            "electron":  "^44.4.3",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "appId":  "com.techflow.app",
                  "productName":  "TechFlow",
                  "directories":  {
                                      "buildResources":  "assets",
                                      "output":  "release"
                                  },
                  "files":  [
                                "**/*",
                                "!release{,/**/*}",
                                "!data/backups{,/**/*}",
                                "!data/folders{,/**/*}",
                                "!data/app.json",
                                "!data/techflow.legacy.json",
                                "!*.log"
                            ],
                  "win":  {
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ],
                              "icon":  "512x512.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true
                           },
                  "artifactName":  "TechFlow-${version}-${arch}.${ext}",
                  "linux":  {
                                "target":  [
                                               "AppImage",
                                               "deb"
                                           ],
                                "category":  "Utility",
                                "synopsis":  "Technical note and documentation manager",
                                "description":  "A desktop application for organizing technical notes, commands and documentation."
                            }
              },
    "dependencies":  {
                         "lucide":  "^1.47.0"
                     }
}
